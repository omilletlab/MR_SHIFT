;tdP.1D			;td 11/09/2024
;ex zgig
;1D sequence with inverse gated decoupling
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=

;--- 1H (f2) ---
;sfo2 ~ 3.5 [ppm] (center of H{31P} for decoupling)
;o2 ~ 3.5 [ppm] (center of H{31P} for decoupling)
;cnst61 >= 4 [ppm] bandwidth of 1H{31P} for decoupling
;p1 = 90deg on 1H (@ pl2)
;pl2 = for p1=90deg on 1H
;cpdprg2 = ### DIPSI2.p61 ###
;p61 ~ 1/(4*SWH[1H{X-coupled}]) (90deg 1H dec. pulse) 
;--- 31P (f1) ---
;p5 <= 90deg on 31P (@pl1)
;pl1 = for p5=90deg on 31P
;---- Delays ----
;d1 = TOTAL interscan delay (1.25*T1(31P) for max.SN, >3*T1(31P) for quantification)

#include <Avance.incl>

;------------ Definitions ---------
;--- 1H(f2) ---
"l11=(aq/115.12)*(4*cnst61*bf2/1000000)"  ;DIPSI2 supercycles for 1H decoupling
"p61=aq/(l11*115.12)"                     ;matched 1H DIPSI2 decoupler pulse
"plw12 = plw2*pow(p1/p61,2)"

define delay d1a
define delay d1c
"d11=30m"
"d1a=(aq+d11)"
"d1c=d1-d1a"

"acqt0=-p5*2/PI"

1 ze
  1m pl2:f2
  (p1 ph1):f2
  d11 pl12:f2
2 d11 do:f2
  d1c
  p5 ph1
  go=2 ph31 cpd2:f2
  d11 do:f2 mc #0 to 2 F0(zd)
exit

ph1=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1

;pl1 : f1 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;p1 : f1 channel -  high power pulse
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;ns: 1 * n, total number of scans: NS * TD0
;cpd2: decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - 90 degree pulse for decoupling sequence

;$Id: zgig,v 1.10.8.1 2012/01/31 17:56:42 ber Exp $
