# 1 "/root/.topspin-BladeEpu/local_acqu/P31metabol_Casqueria_240423/2721/lists/pp/tdP.1D"
;tdP.1D			;td 11/09/2024
;ex zgig
;1D sequence with inverse gated decoupling
;
;$CLASS=HighRes
;$DIM=1D
;$TYPE=
;$SUBTYPE=
;$COMMENT=

;--- 1H (f2) ---
;sfo2 ~ 3.5 [ppm] (center of H{31P} for decoupling)
;o2 ~ 3.5 [ppm] (center of H{31P} for decoupling)
;cnst61 >= 4 [ppm] bandwidth of 1H{31P} for decoupling
;p1 = 90deg on 1H (@ pl2)
;pl2 = for p1=90deg on 1H
;cpdprg2 = ### DIPSI2.p61 ###
;p61 ~ 1/(4*SWH[1H{X-coupled}]) (90deg 1H dec. pulse) 
;--- 31P (f1) ---
;p5 <= 90deg on 31P (@pl1)
;pl1 = for p5=90deg on 31P
;---- Delays ----
;d1 = TOTAL interscan delay (1.25*T1(31P) for max.SN, >3*T1(31P) for quantification)

# 1 "/root/.topspin-BladeEpu/local_acqu/P31metabol_Casqueria_240423/2721/lists/pp/Avance.incl" 1
;Avance4.incl
;   for AV 4
;
;avance-version (16/08/18)
;
;$CLASS=Common Incl
;$COMMENT=


